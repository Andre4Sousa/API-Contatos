generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model contato {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  telefone  String
  endereco  String
  createdAt DateTime @default(now())

  @@map("contato")
}